# Настройки проекта.
# Скопируйте в .env и меняйте только то, что нужно локально.
# Все переменные имеют значения по умолчанию в docker-compose.yaml.

# Порты на хосте
PORTAL_PORT=8080
RANCHER_PORT=8443

# Rancher
RANCHER_VERSION=v2.9.3
RANCHER_BOOTSTRAP_PASSWORD=local-dev-only-change-me
RANCHER_ADMIN_PASSWORD=MyStrongAdminPassword123!
TOKEN_FILE_PATH=/shared/rancher_token.txt
SERVER_EXTERNAL_URL=https://localhost:8443